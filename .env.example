# Copier ce fichier en .env (ignoré par Git) et changer les mots de passe.
POSTGRES_PASSWORD=change-me-postgres
ORDERS_DB_PASSWORD=change-me-orders
CATALOGUE_DB_PASSWORD=change-me-catalogue
VENUES_DB_PASSWORD=change-me-venues
PAYMENT_DB_PASSWORD=change-me-payment

# Port on the host machine (change it if a local PostgreSQL already uses 5432).
POSTGRES_HOST_PORT=5432
